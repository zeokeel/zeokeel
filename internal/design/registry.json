  "scenarios": [
    {
      "id": "agent.reasoning",
      "entry": "uikit.ReasoningTrace",
      "forbid": [
        "Card",
        "always_expanded",
        "body_inline"
      ],
      "requires": [
        "ui.CollapsibleBase",
        "markdown.View",
        "markdown.Stream",
        "Spinner"
      ],
      "doc": "docs/DESIGN.md §2.1 / 附录 A"
    },
    {
      "id": "agent.streaming",
      "entry": "uikit.SessionThread",
      "requires": [
        "ListState.FollowEnd",
        "markdown.Stream",
        "HoldPlace",
        "ScrollToEnd"
      ],
      "forbid": [
        "Scroll+loop",
        "manual-stick-to-bottom",
        "message-card-wall"
      ],
      "doc": "docs/DESIGN.md §2.1 / 附录 A"
    }
  ],
  "anti_patterns": [
    {
      "id": "AP-01",
      "rule": "DS-01",
      "message": "UI 层写颜色字面量（hex / ui.RGBA / ui.Hex）；改用 design.Tokens / c.Theme()，阴影用 t.ShadowOverlay()",
      "doc": "docs/DESIGN.md §3.1 / DESIGN-LINT §3.1"
    },
    {
      "id": "AP-02",
      "rule": "DS-02",
      "message": "覆写官方控件背景/边框/状态色；只设度量，颜色交给主题",
      "doc": "docs/DESIGN.md §3.1 / DESIGN-LINT §3.2"
    },
    {
      "id": "AP-03",
      "rule": "DS-03",
      "message": "裸数值度量（FontSize/FontWeight/Padding/Height/Size/Width/Radius/Shadow 等字面量）；改用 design.Space*/Radius*/DialogWidth*/t.Font(Type*)",
      "doc": "docs/DESIGN.md §3.1 / DESIGN-LINT §3.3"
    },
    {
      "id": "AP-04",
      "rule": "DS-06",
      "message": "手搓官方已有标准交互组件；用官方件或对应 *Base，自绘必须在 registry allowlist 登记",
      "doc": "docs/DESIGN.md §3.1 / §7 / DESIGN-LINT §3.6"
    },
    {
      "id": "AP-05",
      "rule": "DS-04",
      "message": "通用容器/组件模拟专用组件（Card 拼 CoT、Dialog 拼审批）；走 §2 场景入口",
      "doc": "docs/DESIGN.md §3.1 / DESIGN-LINT §3.4"
    },
    {
      "id": "AP-06",
      "rule": "DS-04",
      "message": "纯文本代替结构化 slot（工具结果/选项/推理当正文）；条目化 + 折叠 + 可复制段",
      "doc": "docs/DESIGN.md §3.1"
    },
    {
      "id": "AP-07",
      "rule": "DS-05",
      "message": "给默认组件加多余 options/样式覆写；最短调用，确有需求走预设/入口",
      "doc": "docs/DESIGN.md §3.1 / DESIGN-LINT §3.5"
    },
    {
      "id": "AP-08",
      "rule": "DS-09",
      "message": "状态语义降级（error→warning/普通文本；审批动词中性化；active→running）；用 semantic.error 与真实 RunState",
      "doc": "docs/DESIGN.md §3.1 / DESIGN-LINT §3.9"
    },
    {
      "id": "AP-09",
      "rule": "DS-04,DS-09",
      "message": "用 tab/badge 承担分支/状态机；改用分支/线程原语与状态组件",
      "doc": "docs/DESIGN.md §3.1"
    },
    {
      "id": "AP-10",
      "rule": "DS-07",
      "message": "图标乱用（emoji/Unicode/手写 SVG/尺寸裸值）；用 internal/icons + ui.Icon，尺寸走 token",
      "doc": "docs/DESIGN.md §3.1 / DESIGN-LINT §3.7"
    },
    {
      "id": "AP-11",
      "rule": "DS-06",
      "message": "自绘 base 不处理 Hovered/Pressed/Focused/Selected；官方件优先，自绘补齐全部状态",
      "doc": "docs/DESIGN.md §3.1 / DESIGN-LINT §3.6"
    },
    {
      "id": "AP-12",
      "rule": "DS-10",
      "message": "对话框反惯例（主操作在左、危险动作默认焦点、Esc 语义与提示不一致）；DialogFooter 排序，危险/审批无 Default",
      "doc": "docs/DESIGN.md §3.1 / DESIGN-LINT §3.10"
    },
    {
      "id": "AP-13",
      "rule": "DS-03",
      "message": "流式内容导致几何跳动；用 ListState.FollowEnd + HoldPlace + 固定占位（帧测试为准）",
      "doc": "docs/DESIGN.md §3.1"
    },
    {
      "id": "AP-14",
      "rule": "DS-08",
      "message": "虚构官方 API（ui.DialogFooter/Button.Default/ui.Markdown/ui.DatePicker/ui.CommandPalette 等）；用 §1.2 组合与 uikit 封装",
      "doc": "docs/DESIGN.md §7.4 / DESIGN-LINT §3.8"
    },
    {
      "id": "AP-15",
      "rule": "DS-08",
      "message": "新增组件/自绘不登记（DESIGN.md/registry/白名单/测试不同步）；走 §7.2 流程与 §8.3 同步义务",
      "doc": "docs/DESIGN.md §7.2 / §8.3"
    },
    {
      "id": "AP-16",
      "rule": "",
      "check": "go tool mygo vet + 帧测试",
      "message": "build 回调做 I/O、每帧构建全量集合、跨线程直接改 UI；缓存 + 显式刷新 + UIRuntime.Post",
      "doc": "docs/DESIGN.md §3.1"
    },
    {
      "id": "AP-17",
      "rule": "DS-06,DS-07",
      "message": "覆盖原生控件尺寸导致焦点环/命中区异常；图标按钮 ≥ 24×24 目标区且必须 Label+Tooltip",
      "doc": "docs/DESIGN.md §3.1"
    },
    {
      "id": "AP-18",
      "rule": "DS-02",
      "message": "用状态色小字当正文（Success/Warning/Danger 直接作正文前景）；用 *Text 变体（WCAG-AA）",
      "doc": "docs/DESIGN.md §3.1 / DESIGN-LINT §3.2"
    }
  ],

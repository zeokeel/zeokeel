    {
      "id": "agent.approval",
      "entry": "uikit.ApprovalDialog",
      "package": "internal/uikit",
      "states": [
        "pending",
        "allowed",
        "denied",
        "allowed-always"
      ],
      "rules": [
        "no-default-action",
        "escape-denies",
        "danger-first-primary-last"
      ],
      "forbidden": [

        "running",
        "success",
        "error",
        "cancelled",
        "unknown"
      ],
      "allowed": [
        "uikit.ToolRow",
        "uikit.ToolPanelSectionView",
        "uikit.ToolPreview"
      ],
      "forbidden": [

{
  "version": 1,
  "entries": [
    {
      "id": "appinfo",
      "module": "zeokeel/appinfo",
      "config": {
        "name": "ZeoKeel"
      }
    },
    {
      "id": "store",
      "module": "zeokeel/sessionstore",
      "config": {}
    },
    {
      "id": "approvals",
      "module": "zeokeel/approvals",
      "config": {
        "mode": "auto"
      }
    },
    {
      "id": "workspace",
      "module": "zeokeel/workspace",
      "config": {}
    },
    {
      "id": "terminal",
      "module": "zeokeel/terminal",
      "config": {}
    },
    {
      "id": "skills",
      "module": "zeokeel/skills",
      "config": {}
    },
    {
      "id": "memory",
      "module": "zeokeel/memory",
      "config": {}
    },
    {
      "id": "toolkit",
      "module": "zeokeel/toolkit",
      "config": {
        "root": ".",
        "shellTimeoutMs": 30000

{
  "version": 1,
  "entries": [
    {
      "id": "appinfo",
      "module": "zeokeel/appinfo",
      "config": {
        "name": "ZeoKeel"
      }
    },
    {
      "id": "toolkit",
      "module": "zeokeel/toolkit",
      "config": {
        "root": ".",
        "shellTimeoutMs": 30000
      }
    },
    {
      "id": "hosttools",
      "module": "zeokeel/hosttools",
      "config": {
        "interactive": true
      }
    },
    {
      "id": "agent",
      "module": "zeokeel/agent",
      "config": {
        "model": "gpt-4o-mini",
        "maxIterations": 20
      }
    },
    {
      "id": "ui",
      "module": "zeokeel/host/group",
      "children": [
        {
          "id": "home",
          "module": "zeokeel-ui/home",
          "config": {
            "title": "首页",
            "greeting": "编译期模块化的桌面 AI agent。"
          }
        },
        {
          "id": "welcome",
          "module": "zeokeel-ui/welcome",
          "config": {
            "title": "欢迎使用 ZeoKeel",
            "message": "这是一个独立编译的 UI 模块，通过注入点出现在宿主中。"
          }
        },
        {
          "id": "toolcards",
          "module": "zeokeel-ui/toolcards",
          "config": {
            "title": "工具调用"
          }
        },
        {
          "id": "about",
          "module": "zeokeel-ui/about",
          "config": {
            "title": "关于"
          }
        },
        {
          "id": "sidebar",
          "module": "zeokeel-ui/sidebar",
          "config": {
            "newChatLabel": "新对话",
            "sessionsTitle": "会话",
            "settingsLabel": "设置"
          }
        },
        {
          "id": "session",
          "module": "zeokeel-ui/session",
          "config": {
            "title": "对话",
            "emptyText": "还没有消息，开始一段新对话吧。",
            "composerPlaceholder": "向 ZeoKeel 提问…",
            "sendLabel": "发送",
            "stopLabel": "停止"
          }
        },
        {
          "id": "settings",
          "module": "zeokeel-ui/settings",
          "config": {
            "title": "模型",
            "saveLabel": "保存"
          }
        }
      ]
    }
  ]
}

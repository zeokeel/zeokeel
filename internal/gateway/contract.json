      "session.subscribe",
      "settings",
      "settings.set",
      "workspace"
    ],
    "conditional": [
      {
        "name": "context",
        "when": "KeyContext"
      },
      {
        "name": "edit",
        "when": "SessionEditor"
      },
      {
        "name": "regenerate",
        "when": "SessionRegenerator"
      },
      {
        "name": "tasks",
        "when": "KeyTaskBoard"
      },
      {
        "name": "team",
        "when": "KeyTeam"
      }
    ]

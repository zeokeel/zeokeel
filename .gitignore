# ZeoKeel — build outputs & local state
/dist/
/build/
/assets/
/zeokeel
/zeokeel.exe
*.test

# Archived pre-restructure project (kept as reference; own Go module)

# Local agent tooling (not product code)
/.agents/

# Research probes (not product code)
/.probe/
/.cache/

# Local secrets — never commit API keys or managed endpoints.
.env
.env.*
*.secret
*.key
.credentials*
/credentials*

# Local build output of the snapshot devtool (use go run ./internal/devtools/ui-snapshot).
/ui-snapshot
/ui-drive

# Browser client build copied into the gateway's embed directory by
# scripts/build-web-client.sh (the .keep marker keeps go:embed compiling).
/internal/gateway/webclient/dist/*
!/internal/gateway/webclient/dist/.keep

# ZeoKeel — build outputs & local state
/dist/
/build/
/zeokeel
/zeokeel.exe
*.test

# Archived pre-restructure project (kept as reference; own Go module)
# old/ is tracked on purpose; only its build outputs are ignored.
/old/dist/
/old/zeokeel
/old/zeokeel.exe
/old/*.test

# Research probes (not product code)
/.probe/
/.cache/

# Local secrets — never commit API keys or managed endpoints.
.env
.env.*
*.secret
*.key
.credentials*
/credentials*

# Local secrets — never commit API keys or managed endpoints.
.env
.env.*
*.secret
*.key
# Only dot-prefixed credential files anywhere (DSH uses .credentials.yaml) and
# root-level ones. Do NOT use a bare `credentials*`: it also hides source files
# such as internal/importer/credentials.go, which a clean checkout then cannot
# build (BUILD-01, caught by scripts/check-clean-checkout.sh).
.credentials*
/credentials*
.cache/
.probe/

# Build outputs (large binaries; rebuild, don't commit).
# Canonical output is dist/ (scripts/build.sh); the repo-root names are kept
# ignored so legacy or manual `go build ./cmd/zeokeel` runs never get committed.
dist/
/build/
/zeokeel
/zeokeel.exe
*.test

# Self-evolution machine-local state (reports live in .evolve/research/).
.evolve/state/
.evolve/runs/

# DSH pixel-parity assets (retired 2026-11-05; archived outside the repo).
/baseline/
/artifacts/
/internal/shell/artifacts/
/internal/shell/.cache/
